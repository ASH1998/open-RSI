# Copy to .env and fill values locally. Never commit real credentials.
# Blank secrets are intentional. No jobs or providers have been provisioned.
# Load these variables explicitly before importing SDKs; see docs/SETUP.md.

# Project-defined settings: future launchers must implement these RSI_* fields.
RSI_PROJECT_ROOT=/Volumes/DevSSDWD/openbmb/rsi
RSI_PRIMARY_PROVIDER=modal
RSI_SECONDARY_PROVIDER=kaggle
RSI_MODEL_ID=openbmb/MiniCPM5-2B
# Provisional model. Resolve an immutable Hub commit before experiments.
RSI_MODEL_REVISION=
RSI_MODAL_APP_NAME=open-rsi
RSI_MODAL_VOLUME_NAME=open-rsi-artifacts

# Modal: required for primary-provider jobs.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# W&B / CoreWeave Forge: key required only for online tracking.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=open-rsi
WANDB_MODE=offline

# Kaggle: optional secondary GPU/TPU provider; current CLI token authentication.
KAGGLE_API_TOKEN=

# Hugging Face: optional for public downloads, required for private/gated access
# or uploads. No OpenAI/OpenBMB inference API key is required.
HF_TOKEN=

# Local paths: keep all project-managed caches/configuration on the SSD.
# Create directories before use. Override these on Modal/Kaggle workers.
HF_HOME=/Volumes/DevSSDWD/openbmb/rsi/.cache/huggingface
XDG_CACHE_HOME=/Volumes/DevSSDWD/openbmb/rsi/.cache
PIP_CACHE_DIR=/Volumes/DevSSDWD/openbmb/rsi/.cache/pip
UV_CACHE_DIR=/Volumes/DevSSDWD/openbmb/rsi/.cache/uv
TORCH_HOME=/Volumes/DevSSDWD/openbmb/rsi/.cache/torch
TMPDIR=/Volumes/DevSSDWD/openbmb/rsi/.cache/tmp
WANDB_DIR=/Volumes/DevSSDWD/openbmb/rsi/runs
WANDB_CACHE_DIR=/Volumes/DevSSDWD/openbmb/rsi/.cache/wandb
WANDB_CONFIG_DIR=/Volumes/DevSSDWD/openbmb/rsi/.config/wandb
WANDB_DATA_DIR=/Volumes/DevSSDWD/openbmb/rsi/work/wandb
WANDB_ARTIFACT_DIR=/Volumes/DevSSDWD/openbmb/rsi/artifacts
KAGGLE_CONFIG_DIR=/Volumes/DevSSDWD/openbmb/rsi/.config/kaggle
